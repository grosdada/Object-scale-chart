{
  "name": "echelle-studio",
  "version": "1.1.0",
  "private": true,
  "main": "electron-main.cjs",
  "description": "Atelier local de comparaison de proportions pour la vidéo IA",
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "build:ai": "esbuild ai-cutout-entry.js --bundle --minify --format=iife --platform=browser --outfile=ai-cutout.js",
    "vectorize": "node scripts/vectorize_subjects.cjs",
    "desktop": "electron .",
    "dist:win": "npm run build:ai && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@imgly/background-removal": "^1.7.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "onnxruntime-web": "^1.21.0",
    "playwright": "^1.63.0",
    "potrace": "^2.1.8"
  },
  "build": {
    "appId": "com.grosdada.echelle",
    "productName": "Echelle",
    "artifactName": "Echelle-${version}-portable.${ext}",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "catalogue.js",
      "core.js",
      "cutout.js",
      "ai-cutout.js",
      "THIRD_PARTY_NOTICES.md",
      "subject-vectors.js",
      "version.js",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    }
  }
}
