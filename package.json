{
  "name": "echelle-studio",
  "version": "1.1.0",
  "private": true,
  "main": "electron-main.cjs",
  "description": "Atelier local de comparaison de proportions pour la vidéo IA",
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "vectorize": "node scripts/vectorize_subjects.cjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "potrace": "^2.1.8"
  },
  "build": {
    "appId": "com.grosdada.echelle",
    "productName": "Echelle",
    "artifactName": "Echelle-${version}-portable.${ext}",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "catalogue.js",
      "core.js",
      "cutout.js",
      "subject-vectors.js",
      "version.js",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json"
    ],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": ["portable"], "icon": "build/icon.ico" }
  }
}
